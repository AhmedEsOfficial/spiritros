# =============================================================================
# SpiritROS Phase 1 — Ollama Environment Variables
# =============================================================================

# Network binding
OLLAMA_HOST=0.0.0.0:11434

# Model storage location (shared with SpiritROS model management)
OLLAMA_MODELS=/var/lib/spiritros/models

# Maximum number of models loaded simultaneously
OLLAMA_MAX_LOADED_MODELS=2

# Maximum concurrent requests per model
OLLAMA_NUM_PARALLEL=4

# Maximum queue length before rejecting requests
OLLAMA_MAX_QUEUE=256

# GPU layers: -1 = auto (offload all that fit)
OLLAMA_GPU_LAYERS=-1

# Keep models loaded in memory (seconds, 0 = unload immediately, -1 = forever)
OLLAMA_KEEP_ALIVE=300

# Flash attention (reduces VRAM usage for long contexts)
OLLAMA_FLASH_ATTENTION=1

# Logging level
OLLAMA_DEBUG=false
