  "panels": [
    {
      "title": "FUSE Operations / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(spirit_fs_fuse_reads_total[1m])",
          "legendFormat": "reads/s",
          "refId": "A"
        },
        {
          "expr": "rate(spirit_fs_fuse_writes_total[1m])",
          "legendFormat": "writes/s",
          "refId": "B"
        },
        {
          "expr": "rate(spirit_fs_fuse_lookups_total[1m])",
          "legendFormat": "lookups/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "title": "FUSE Operation Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(spirit_fs_fuse_op_latency_us_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(spirit_fs_fuse_op_latency_us_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(spirit_fs_fuse_op_latency_us_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
