# SpiritROS Phase 1 — Development Docker Image
# Includes debug tools, builds in debug mode, supports live source mounts

FROM nvidia/cuda:12.8.0-devel-ubuntu24.04

LABEL maintainer="SpiritROS Team"
LABEL description="SpiritROS Phase 1 — Development Image"

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies + development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build dependencies
    pkg-config \
    libfuse3-dev \
    libssl-dev \
    protobuf-compiler \
    build-essential \
    # Runtime dependencies
    libfuse3-3 \
    fuse3 \
    curl \
    ca-certificates \
    # Development tools
    gdb \
    strace \
    linux-tools-generic \
    vim \
    htop \
    git \
    valgrind \
    tmux \
    jq \
    less \
    # Python tooling
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --default-toolchain 1.82.0 \
    --component rustfmt,clippy,rust-src
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Rust dev tools
RUN cargo install cargo-watch cargo-nextest cargo-criterion

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Create directories
RUN mkdir -p /workspace \
             /opt/spiritros/bin \
             /opt/spiritros/config \
             /opt/spiritros/scripts \
             /var/lib/spiritros/models \
             /var/lib/spiritros/data \
             /var/log/spiritros \
             /mnt/spiritfs

WORKDIR /workspace

# Copy configuration and scripts (these may be overridden by volume mounts)
COPY docker/config/ /opt/spiritros/config/
COPY docker/scripts/ /opt/spiritros/scripts/
RUN chmod +x /opt/spiritros/scripts/*.sh

ENV PATH="/opt/spiritros/bin:/workspace/target/debug:${PATH}"
ENV SPIRIT_CONFIG="/opt/spiritros/config/spirit.yaml"
ENV SPIRIT_LOG_DIR="/var/log/spiritros"
ENV SPIRIT_DATA_DIR="/var/lib/spiritros/data"
ENV SPIRIT_MODEL_DIR="/var/lib/spiritros/models"
ENV OLLAMA_HOST="0.0.0.0:11434"
ENV OLLAMA_MODELS="/var/lib/spiritros/models"
ENV RUST_BACKTRACE=1
ENV RUST_LOG=debug

# Ports:
#   11434 — Ollama API
#   50051 — Spirit Inference Coordinator (gRPC)
#   8080  — Spirit REST API
#   9090  — Metrics (Prometheus exposition)
#   6060  — tokio-console (async debugging)
EXPOSE 11434 50051 8080 9090 6060

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=120s \
    CMD /opt/spiritros/scripts/health-check.sh

ENTRYPOINT ["/opt/spiritros/scripts/entrypoint.sh"]
CMD ["bash"]
